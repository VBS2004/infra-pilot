# Copy to .env (gitignored) and `source` it, or export these in your shell.
# Never commit real keys.

# --- Generation (any OpenAI-compatible API) --------------------------------
OPENAI_API_KEY=replace-me
LLM_GATEWAY_BASE=https://api.deepseek.com
LLM_GEN_MODEL=deepseek-chat
# Cheapest DeepSeek mode (no reasoning tokens). Omit for gateways that do not support it.
# LLM_THINKING=disabled

# --- Dense retrieval (optional; BM25-only when unset) ------------------------
# The `auto` backend only uses HTTP when this is set, else a local
# sentence-transformers model if installed, else BM25 alone.
# LLM_EMBED_GATEWAY_BASE=http://localhost:8000
# LLM_EMBED_MODEL=BAAI/bge-small-en-v1.5
# LLM_LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
# LLM_EMBED_BACKEND=auto            # auto | http | sentence_transformers | none

# --- Reranking (optional; runs ONLY when this is set) ----------------------
# LLM_RERANK_GATEWAY_BASE=http://localhost:8080   # python reranker_server.py
# LLM_RERANK_MODEL=                               # auto-discovered via /v1/models

# --- Air-gapped local generation (optional) ----------------------------------
# LOCAL_MODEL=/path/to/hf/model
# LOCAL_DEVICE=cuda                 # default: cuda if available, else cpu
